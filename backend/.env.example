# ─────────────────────────────────────────────────────────────
# Campus Pulse AI — Backend Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=CampusPulseAI
APP_VERSION=1.0.0
APP_ENV=development            # development | production
DEBUG=true

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=changeme-use-a-very-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MongoDB (Local / Compass)
MONGODB_URL=mongodb://localhost:27017
DB_NAME=campus_pulse

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LLM API (optional — for Copilot)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ML
MODEL_DIR=./models
DATA_DIR=./datasets
SEED=42
